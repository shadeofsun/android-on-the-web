# ============================================================================
# Copy to .env and fill in. NEVER commit the real .env (it is in .gitignore).
#   cp .env.example .env
#   openssl rand -hex 32     # -> API_TOKEN
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------

# Bearer token for every API call. The service refuses to start without it.
# Minimum 16 characters; 64 hex characters recommended.
API_TOKEN=change-me-openssl-rand-hex-32

# Container image published by the GitHub Actions workflow.
IMAGE=ghcr.io/shadeofsun/android-on-the-web:latest

# Public hostname handled by Traefik / Dokploy.
DOMAIN=android.example.com


# --- EMULATOR ---------------------------------------------------------------

# Guest RAM in MB. Must fit inside the container memory limit (8G by default).
EMULATOR_RAM=4096

# Guest vCPUs. Keep at or below the host core count.
EMULATOR_CORES=4

# Seconds to wait for sys.boot_completed before giving up.
BOOT_TIMEOUT=300

# true -> boot with -wipe-data, resetting userdata on every start.
WIPE_DATA=false

# true -> zero out window/transition/animator scales after boot (faster).
DISABLE_ANIMATIONS=true

# Extra emulator flags, space separated. Advanced use only.
# EMULATOR_EXTRA_ARGS=-writable-system


# --- API --------------------------------------------------------------------

# allowlist (default) | unrestricted
# 'unrestricted' gives anyone with API_TOKEN arbitrary shell on the device.
SHELL_MODE=allowlist

# Comma-separated override of the allowed first binaries in allowlist mode.
# SHELL_ALLOWED_BINARIES=pm,am,input,dumpsys,getprop,setprop,settings,screencap,wm,ls,cat,cmd,monkey,logcat,ps,df

# Per-command timeout in seconds.
SHELL_TIMEOUT=30

# Maximum APK upload size in MB.
MAX_APK_MB=200

# Timeout for `adb install`, in seconds (big APKs on a cold device are slow).
INSTALL_TIMEOUT=300

# Per-IP rate limit, slowapi syntax (e.g. 60/minute, 1000/hour).
RATE_LIMIT=60/minute

# Set to false only for load testing behind a private network.
RATE_LIMIT_ENABLED=true

# uvicorn log level: critical | error | warning | info | debug | trace
LOG_LEVEL=info


# --- ADVANCED ---------------------------------------------------------------

# adb serial of the emulator inside the container.
# ADB_SERIAL=emulator-5554

# Generic adb timeout in seconds.
# ADB_TIMEOUT=30

# Max lines emitted by a single /api/logcat SSE connection before it closes.
# LOGCAT_MAX_LINES=5000

# Set device properties at boot: ADB_PROP_<name with dots as underscores>
# ADB_PROP_debug_layout=false

# Semicolon-separated `adb shell` commands run once after boot.
# EXTRA_SETTINGS_CMDS=settings put system screen_off_timeout 1800000; settings put global stay_on_while_plugged_in 3
